# Salin file ini menjadi .env lalu isi nilainya sebelum `docker compose up`.
# File .env sudah di-gitignore.

# --- Port host API (5000 bebas; jangan 8080 karena sudah dipakai project lain) ---
API_HOST_PORT=5000

# --- Database: pakai ulang container formup-mssql-prod (network formup-net) ---
# Ganti <password> dengan MSSQL_SA_PASSWORD container tersebut.
DB_CONNECTION=Server=formup-mssql,1433;Database=FormUpDb;User Id=sa;Password=<password>;TrustServerCertificate=True;MultipleActiveResultSets=True

# --- JWT (minimal 32 karakter, jangan pakai default) ---
JWT_KEY=GANTI_DENGAN_RANDOM_KEY_PANJANG_MINIMAL_32_KARAKTER

# --- SMTP (OTP & reset password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Aplikasi ---
PUBLIC_URL=https://formup.my.id
ASPNETCORE_ENVIRONMENT=Production

# --- Cloudflare Tunnel (token dari dashboard Zero Trust) ---
CLOUDFLARE_TUNNEL_TOKEN=