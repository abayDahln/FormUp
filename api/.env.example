DB_CONNECTION=Server=localhost;Database=FormUpDb;Trusted_Connection=True;TrustServerCertificate=True
JWT_KEY=your-super-secret-key-at-least-32-characters
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PUBLIC_URL=https://formup.my.id
# Origin frontend yang boleh memanggil API (pisah koma). Bentuk satu-var ini
# lebih andal daripada AllowedOrigins__0/__1, terutama di hosting — file .env
# di-gitignore dan belum tentu termuat di server. Selalu set juga sebagai
# environment variable asli di host (Docker -e / dashboard Railway/Render).
ALLOWED_ORIGINS=https://formup.my.id,https://www.formup.my.id
